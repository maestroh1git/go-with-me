# ── Server ────────────────────────────────────────────────────────────────────
HTTP_PORT=8080
APP_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Primary / write DB (required)
DATABASE_WRITE_URL=postgres://user:pass@localhost:5432/go_with_me?sslmode=disable

# Optional read replicas (comma-separated). Leave empty for single-node local dev.
# DATABASE_READ_URLS=postgres://user:pass@replica1:5432/go_with_me?sslmode=disable,postgres://user:pass@replica2:5432/go_with_me?sslmode=disable
DATABASE_READ_URLS=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Secrets ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Must be at least 32 characters. CHANGE THIS IN PRODUCTION.
APP_SECRET=your-super-secret-key-min-32-chars-change-this-in-production

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_EXPIRY_HOURS=24
MFA_EXPIRY_MINUTES=10
TOTP_SETUP_EXPIRY_MINUTES=60
PASSWORD_RESET_OTP_MINUTES=15
PASSWORD_RESET_JWT_MINUTES=30

# ── Security ──────────────────────────────────────────────────────────────────
MAX_FAILED_ATTEMPTS=5
INVITE_TTL_HOURS=168

# ── Bootstrap super admin ─────────────────────────────────────────────────────
# Creates the first super_admin on startup when no super_admin exists.
# Leave empty to skip (safe to leave after first run).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login
BOOTSTRAP_ADMIN_NAME=Super Admin

# ── SMTP (optional) ───────────────────────────────────────────────────────────
# Leave empty in development — OTPs will be logged to console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ── Events ────────────────────────────────────────────────────────────────────
EVENT_STREAM=app:events
